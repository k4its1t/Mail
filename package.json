{
  "name": "mail",
  "version": "0.1.0",
  "description": "Windows-first, local-only unified inbox for multiple IMAP accounts.",
  "main": "./out/main/index.js",
  "author": "Mail Contributors",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "pnpm build && electron-builder",
    "dist:win": "pnpm build && electron-builder --win zip --x64",
    "dist:win:installer": "pnpm build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "imapflow": "1.6.6",
    "mailparser": "3.9.16",
    "sanitize-html": "2.17.5"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.10.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
